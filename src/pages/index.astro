---
import Base from '../layouts/Base.astro'
import Stamp from '../components/Stamp.astro'
import Footer from '../components/Footer.astro'
import RsvpModal from '../components/RsvpModal.astro'
---
<Base title="Owen & Rowan — July 11, 2026" ogTitle="Owen & Rowan 2026">

  <!-- ─── Hero ────────────────────────────────────────────────────────────── -->
  <section class="min-h-screen flex flex-col px-6 pt-16 md:pt-24 pb-8 md:pb-16 relative overflow-hidden">

    <img
      src="/illustrations/pinon-bg.svg"
      alt=""
      aria-hidden="true"
      class="absolute right-0 top-1/4 w-1/2 max-w-sm pointer-events-none select-none"
      style="opacity: 0.08; color: var(--c-ink);"
      width="400"
      height="600"
    />

    <!-- Mobile-only: location label at top of window -->
    <p class="md:hidden relative z-10 type-label max-w-5xl w-full mx-auto mb-6" style="color: color-mix(in srgb, var(--c-ink) 50%, transparent);" data-reveal>
      New Mexico Museum of Art — Santa Fe
    </p>

    <!-- Main content: fills remaining vertical space, side-by-side on all sizes -->
    <div class="relative z-10 flex-1 max-w-5xl mx-auto w-full flex flex-col justify-center">

      <!-- Heading + photo row -->
      <div class="flex flex-row items-start gap-3 md:items-center md:gap-16">

        <!-- Left: heading (+ stamp on desktop) -->
        <div class="flex-1 min-w-0 mt-10 md:mt-0">
          <!-- Desktop-only label inside the text column -->
          <p class="hidden md:block type-label mb-6" style="color: color-mix(in srgb, var(--c-ink) 50%, transparent);" data-reveal>
            New Mexico Museum of Art — Santa Fe
          </p>

          <h1
            class="type-display leading-none mb-4 md:mb-8"
            style="font-size: clamp(4.5rem, 10vw, 8rem);"
            data-reveal
          >
            Owen<br />&amp;<br />Rowan
          </h1>

          <!-- Desktop-only stamp+tagline inside the text column -->
          <div class="hidden md:flex items-center gap-8" data-reveal>
            <Stamp text="July 11" subtext="2026" variant="circle" color="terracotta" easterEgg={true} />
            <p class="max-w-xs leading-relaxed" style="color: color-mix(in srgb, var(--c-ink) 70%, transparent);">
              A wedding in the high desert.
            </p>
          </div>
        </div>

        <!-- Photo: shown on all sizes, top-aligned on mobile, centered on desktop -->
        <div class="flex-shrink-0 w-[52%] md:w-64 lg:w-80 xl:w-96 -mt-30 md:mt-0" data-reveal>
          <img
            src="/images/main.JPG"
            alt="Owen and Rowan"
            width="550"
            height="550"
            class="w-full h-auto"
            style="filter: grayscale(100%); opacity: 0.9; mix-blend-mode: multiply;"
          />
        </div>

      </div>

      <!-- Mobile-only stamp+tagline below the heading/photo row -->
      <div class="flex md:hidden items-center gap-8 mt-3" data-reveal>
        <Stamp text="July 11" subtext="2026" variant="circle" color="terracotta" easterEgg={true} />
        <p class="leading-relaxed" style="color: color-mix(in srgb, var(--c-ink) 70%, transparent);">
          A wedding in the high desert.
        </p>
      </div>

    </div>
  </section>

  <!-- ─── Story ────────────────────────────────────────────────────────────── -->
  <section class="px-6 pt-10 pb-24 md:py-24 max-w-3xl mx-auto">
    <h2 class="type-label-lg mb-12" style="color: var(--c-terracotta);" data-reveal>The Story</h2>

    <div class="prose-wedding">
      <p data-reveal>
        We met in our junior year at St. John's College in Santa Fe but had our first date in Berlin at the <button class="story-hint" data-photo="/images/story/rowan_bauhaus.JPG">Bauhaus Archive</button>. After leaving we rode the UBahn after buying a <button class="story-hint" data-photo="/images/story/mint.JPG">mint plant</button> to make a <button class="story-hint" data-photo="/images/story/smoothie.JPG">smoothie</button>. We ended up talking late into the night. We continued talking after returning to Santa Fe for our senior year of college and the rest is history.

      </p>

      <p data-reveal>
        We live in Philadelphia now but, on July 11, we're returning to Santa Fe to get married!! The party will take place at the beautiful New Mexico Museum of Art with the people we love most. We hope you'll be there.

      </p>
    </div>

    <aside id="easter-aside" class="hidden mt-8 p-4" style="background: var(--c-base-warm); border-left: 2px solid var(--c-ochre);">
      <p class="type-label" style="color: var(--c-ink);">
        In the Diablo Canyon campsite, Owen had also brought a deck of cards "just in case."
        He never got to use them. Rowan considers this justice.
      </p>
    </aside>
  </section>

  <!-- ─── Story image ─────────────────────────────────────────────────────── -->
  <div class="px-6 max-w-3xl mx-auto w-full" data-reveal>
    <img
      src="/images/story/sunset.png"
      alt=""
      aria-hidden="true"
      class="h-auto"
      style="filter: grayscale(100%); opacity: 0.9; mix-blend-mode: multiply;"
    />
  </div>

  <!-- ─── The Day ──────────────────────────────────────────────────────────── -->
  <section class="px-6 py-24 max-w-4xl mx-auto">
    <div class="diamond-rule mb-12" data-reveal>
      <span aria-hidden="true">◆</span>
    </div>

    <h2 class="type-label-lg mb-12" style="color: var(--c-terracotta);" data-reveal>The Day</h2>

    <div class="grid md:grid-cols-2 gap-16">

      <div data-reveal>
        <div class="space-y-0" style="border-top: 1px solid color-mix(in srgb, var(--c-ink) 20%, transparent);">
          {[
            { time: '5:00 pm',  event: 'Doors Open' },
            { time: '5:30 pm',  event: 'Ceremony' },
            { time: '6:00 pm',  event: 'Cocktail Hour' },
            { time: '7:00 pm',  event: 'Dinner' },
            { time: '8:00 pm',  event: 'Cake Cutting & Dancing' },
            { time: '11:00 pm', event: 'End of the Celebration' },
          ].map(({ time, event }) => (
            <div
              class="flex justify-between items-baseline py-4"
              style="border-bottom: 1px solid color-mix(in srgb, var(--c-ink) 10%, transparent);"
            >
              <span class="type-label" style="color: color-mix(in srgb, var(--c-ink) 60%, transparent);">{time}</span>
              <span style="font-size: var(--text-lg);">{event}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="space-y-6" data-reveal>
        <address class="not-italic leading-relaxed">
          <strong class="type-label block mb-2" style="color: var(--c-ink);">Venue</strong>
          New Mexico Museum of Art<br />
          107 W Palace Ave<br />
          Santa Fe, NM 87501
        </address>
        <p style="color: color-mix(in srgb, var(--c-ink) 60%, transparent); font-size: var(--text-sm);">
          Ceremony in the museum courtyard. </br>If it rains we'll move inside.
        </p>
        <div class="flex gap-6">
          <a
            href="https://maps.apple.com/?q=107+W+Palace+Ave+Santa+Fe+NM"
            class="link-draw type-label"
            target="_blank"
            rel="noopener noreferrer"
          >
            Apple Maps ↗
          </a>
          <a
            href="https://maps.google.com/?q=107+W+Palace+Ave,+Santa+Fe,+NM+87501"
            class="link-draw type-label"
            target="_blank"
            rel="noopener noreferrer"
          >
            Google Maps ↗
          </a>
        </div>
        <a
          href="/venue"
          class="link-draw type-label block"
        >
          More about the venue →
        </a>
      </div>
    </div>

    <div class="diamond-rule mt-16" data-reveal>
      <span aria-hidden="true">◆</span>
    </div>
  </section>

  <!-- ─── RSVP ─────────────────────────────────────────────────────────────── -->
  <section id="rsvp" class="px-6 py-24 max-w-2xl mx-auto text-center">
    <button
      data-rsvp-open
      class="type-label px-16 py-5 cursor-pointer transition-colors"
      style="border: 1px solid var(--c-terracotta); color: var(--c-terracotta); font-size: var(--text-base);"
      onmouseenter="this.style.background='var(--c-terracotta)'; this.style.color='var(--c-base)'"
      onmouseleave="this.style.background='transparent'; this.style.color='var(--c-terracotta)'"
      data-reveal
    >
      RSVP
    </button>
    <p class="type-label-lg mt-6" style="color: color-mix(in srgb, var(--c-ink) 40%, transparent);" data-reveal>
      by June 11, 2026
    </p>
  </section>

  <RsvpModal />


  <!-- ─── Secondary page links ─────────────────────────────────────────────── -->
  <section class="px-6 py-16 max-w-2xl mx-auto">
    <div class="diamond-rule mb-12" data-reveal>
      <span aria-hidden="true">◆</span>
    </div>
    <h2 class="type-label mb-8" style="color: color-mix(in srgb, var(--c-ink) 40%, transparent);" data-reveal>
      Everything else
    </h2>
    <nav aria-label="More info" class="space-y-4">
      {[
        ['/venue',    'The Venue',      ''],
        ['/stay',     'Where to Stay',  ''],
        ['/do',       'Things to Do',   ''],
        ['/registry', 'Registry',       ''],
        ['/faq',      'FAQ',            ''],
      ].map(([href, label, desc]) => (
        <a
          href={href}
          class="flex justify-between items-baseline py-4 group transition-colors"
          style="border-bottom: 1px solid color-mix(in srgb, var(--c-ink) 10%, transparent);"
          data-reveal
          onmouseenter="this.style.borderBottomColor='color-mix(in srgb, var(--c-terracotta) 40%, transparent)'"
          onmouseleave="this.style.borderBottomColor='color-mix(in srgb, var(--c-ink) 10%, transparent)'"
        >
          <span style="font-family: var(--font-family-display); font-size: var(--text-xl); font-weight: 700; color: var(--c-ink);">
            {label}
          </span>
          <span class="type-label hidden md:block" style="color: color-mix(in srgb, var(--c-ink) 40%, transparent); max-width: 30ch; text-align: right;">
            {desc}
          </span>
        </a>
      ))}
    </nav>
  </section>

  <!-- ─── Photo lightbox ──────────────────────────────────────────────────── -->
  <dialog id="photo-lightbox" aria-label="Photo">
    <button id="lightbox-close" aria-label="Close" style="position:absolute;top:1rem;right:1rem;background:none;border:none;cursor:pointer;color:var(--c-base);font-size:1.5rem;line-height:1;opacity:0.7;">✕</button>
    <img id="lightbox-img" src="" alt="" style="display:block;max-width:min(90vw,600px);max-height:85vh;width:auto;height:auto;" />
  </dialog>

  <!-- ─── Easter egg: Konami overlay ───────────────────────────────────────── -->
  <div
    id="konami-overlay"
    class="hidden fixed inset-0 flex items-center justify-center z-50 cursor-pointer"
    style="background: color-mix(in srgb, var(--c-base) 95%, transparent);"
    aria-live="polite"
  >
    <div class="text-center space-y-4 max-w-sm px-6">
      <img src="/images/colophon.svg" alt="" class="w-20 mx-auto dark:invert" width="80" height="80" />
      <p class="type-display" style="font-size: var(--text-2xl);">There you are.</p>
      <p style="color: color-mix(in srgb, var(--c-ink) 60%, transparent);">
        Good instincts. We like you already.
        See you July 11.
      </p>
      <p class="type-label" style="color: color-mix(in srgb, var(--c-ink) 30%, transparent);">
        Click anywhere to close.
      </p>
    </div>
  </div>

  <!-- ─── Closing image ───────────────────────────────────────────────────── -->
  <div class="px-6 max-w-3xl mx-auto w-full" data-reveal>
    <img
      src="/images/story/arizona.JPG"
      alt=""
      aria-hidden="true"
      class="h-auto"
      style="filter: grayscale(100%); opacity: 0.9; mix-blend-mode: multiply;"
    />
  </div>

  <Footer />
</Base>


<script src="../scripts/easter-eggs.js"></script>

<script>
  const lightbox = document.getElementById('photo-lightbox') as HTMLDialogElement
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement

  document.querySelectorAll<HTMLButtonElement>('.story-hint[data-photo]').forEach(btn => {
    btn.addEventListener('click', () => {
      lightboxImg.src = btn.dataset.photo!
      lightbox.showModal()
    })
  })

  document.getElementById('lightbox-close')?.addEventListener('click', () => lightbox.close())
  lightbox?.addEventListener('click', (e) => { if (e.target === lightbox) lightbox.close() })
</script>

<style>
  .story-hint {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    color: inherit;
    cursor: pointer;
    border-bottom: 1px dotted color-mix(in srgb, var(--c-ink) 25%, transparent);
  }

  #photo-lightbox {
    background: transparent;
    border: none;
    padding: 0;
    overflow: visible;
  }

  #photo-lightbox::backdrop {
    background: color-mix(in srgb, var(--c-ink) 80%, transparent);
    backdrop-filter: blur(4px);
  }
</style>
