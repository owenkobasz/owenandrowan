---
import Base from '../layouts/Base.astro'
import Stamp from '../components/Stamp.astro'
import Footer from '../components/Footer.astro'
---
<Base title="Owen & Rowan — July 11, 2026">

  <!-- ─── Hero ────────────────────────────────────────────────────────────── -->
  <section class="min-h-screen flex flex-col justify-center px-6 pt-24 pb-16 relative overflow-hidden">

    <img
      src="/illustrations/pinon-bg.svg"
      alt=""
      aria-hidden="true"
      class="absolute right-0 top-1/4 w-1/2 max-w-sm pointer-events-none select-none"
      style="opacity: 0.08; color: var(--c-ink);"
      width="400"
      height="600"
    />

    <div class="relative z-10 max-w-5xl mx-auto w-full">
      <p class="type-label mb-6" style="color: color-mix(in srgb, var(--c-ink) 50%, transparent);" data-reveal>
        New Mexico Museum of Art — Santa Fe
      </p>

      <h1
        class="type-display leading-none mb-8"
        style="font-size: var(--text-hero);"
        data-reveal
      >
        Owen<br />&amp;<br />Rowan
      </h1>

      <div class="flex items-center gap-8" data-reveal>
        <Stamp text="July 11" subtext="2026" variant="circle" color="terracotta" easterEgg={true} />
        <p class="max-w-xs leading-relaxed" style="color: color-mix(in srgb, var(--c-ink) 70%, transparent);">
          A wedding in the high desert.
        </p>
      </div>
    </div>
  </section>

  <!-- ─── Story ────────────────────────────────────────────────────────────── -->
  <section class="px-6 py-24 max-w-3xl mx-auto">
    <h2 class="type-label mb-12" style="color: var(--c-terracotta);" data-reveal>The Story</h2>

    <div class="prose-wedding">
      <p data-reveal>
        We met in Berlin, at the Bauhaus archive. The exhibit was crowded and we ended up
        standing next to each other in front of the same object for longer than either of us
        would normally stand in front of anything. We introduced ourselves. On the walk back,
        Owen stopped at a German grocery and bought a mint plant. We made smoothies with it
        that night in the apartment we were both staying in, for reasons that still don't
        fully make sense, and talked until it was late.
      </p>

      <p data-reveal>
        We both ended up in Santa Fe — separately, then together. Owen arrived from Pennsylvania
        and felt, immediately, like he'd landed on an alien planet in the best way: the light,
        the altitude, the earth that was the wrong color for somewhere people were supposed to
        live. Rowan had first come as a child visiting family friends and remembered mostly
        the color and the sun. We went to school here, built a life here, and got engaged here —
        camping in Diablo Canyon while a mattress slowly deflated and Esme ran up every cliff
        she could find. Santa Fe is not just where we're getting married. It's <span data-easter="word" class="cursor-pointer border-b border-dashed" style="border-color: var(--c-ochre);">where</span> we became
        what we are.
      </p>

      <p data-reveal>
        We live in Philadelphia now — Northern Liberties, Kettle Black on weekend mornings,
        coffee and whatever museum is showing something worth seeing. Owen plays Magic: The
        Gathering with the focus of a person who takes this more seriously than most things.
        Rowan builds elaborate Sims households and does not apologize for it. Esme remains
        the dog. On July 11, we're coming back to Santa Fe to have a party in a courtyard
        that has outlasted all of us by a few centuries, with the people we love most.
        We hope you'll be there.
      </p>
    </div>

    <aside id="easter-aside" class="hidden mt-8 p-4" style="background: var(--c-base-warm); border-left: 2px solid var(--c-ochre);">
      <p class="type-label" style="color: var(--c-ink);">
        In the Diablo Canyon campsite, Owen had also brought a deck of cards "just in case."
        He never got to use them. Rowan considers this justice.
      </p>
    </aside>
  </section>

  <!-- ─── The Day ──────────────────────────────────────────────────────────── -->
  <section class="px-6 py-24 max-w-4xl mx-auto">
    <div class="diamond-rule mb-12" data-reveal>
      <span aria-hidden="true">◆</span>
    </div>

    <h2 class="type-label mb-12" style="color: var(--c-terracotta);" data-reveal>The Day</h2>

    <div class="grid md:grid-cols-2 gap-16">

      <div data-reveal>
        <div class="space-y-0" style="border-top: 1px solid color-mix(in srgb, var(--c-ink) 20%, transparent);">
          {[
            { time: '6:00 pm',  event: 'Ceremony' },
            { time: '7:00 pm',  event: 'Cocktail Hour' },
            { time: '8:00 pm',  event: 'Dinner & Dancing' },
            { time: '11:00 pm', event: 'End of Evening' },
          ].map(({ time, event }) => (
            <div
              class="flex justify-between items-baseline py-4"
              style="border-bottom: 1px solid color-mix(in srgb, var(--c-ink) 10%, transparent);"
            >
              <span class="type-label" style="color: color-mix(in srgb, var(--c-ink) 60%, transparent);">{time}</span>
              <span style="font-size: var(--text-lg);">{event}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="space-y-6" data-reveal>
        <address class="not-italic leading-relaxed">
          <strong class="type-label block mb-2" style="color: var(--c-ink);">Venue</strong>
          New Mexico Museum of Art<br />
          107 W Palace Ave<br />
          Santa Fe, NM 87501
        </address>
        <p style="color: color-mix(in srgb, var(--c-ink) 60%, transparent); font-size: var(--text-sm);">
          Ceremony in the museum courtyard. If it rains, we move inside —
          the building is beautiful either way.
        </p>
        <div class="flex gap-6">
          <a
            href="https://maps.apple.com/?q=107+W+Palace+Ave+Santa+Fe+NM"
            class="link-draw type-label"
            target="_blank"
            rel="noopener noreferrer"
          >
            Apple Maps ↗
          </a>
          <a
            href="https://maps.google.com/?q=107+W+Palace+Ave,+Santa+Fe,+NM+87501"
            class="link-draw type-label"
            target="_blank"
            rel="noopener noreferrer"
          >
            Google Maps ↗
          </a>
        </div>
        <a
          href="/venue"
          class="link-draw type-label block"
        >
          More about the venue →
        </a>
      </div>
    </div>

    <div class="diamond-rule mt-16" data-reveal>
      <span aria-hidden="true">◆</span>
    </div>
  </section>

  <!-- ─── RSVP ─────────────────────────────────────────────────────────────── -->
  <section id="rsvp" class="px-6 py-24 max-w-2xl mx-auto">
    <h2 class="type-label mb-3" style="color: var(--c-terracotta);" data-reveal>RSVP</h2>
    <p class="type-label mb-12" style="color: color-mix(in srgb, var(--c-ink) 40%, transparent);" data-reveal>
      by June 11, 2026
    </p>

    <div id="rsvp-gate" data-reveal>
      <p class="mb-6" style="color: color-mix(in srgb, var(--c-ink) 70%, transparent);">
        You'll need the password from your invitation.
      </p>
      <div class="flex gap-3">
        <input
          type="password"
          id="rsvp-password"
          placeholder="Password"
          autocomplete="off"
          class="flex-1 bg-transparent px-4 py-3"
          style="border: 1px solid color-mix(in srgb, var(--c-ink) 30%, transparent); font-family: var(--font-family-body); color: var(--c-ink);"
          onfocus="this.style.borderColor='var(--c-terracotta)'"
          onblur="this.style.borderColor='color-mix(in srgb, var(--c-ink) 30%, transparent)'"
        />
        <button
          onclick="checkRSVPPassword()"
          class="type-label px-6 py-3 cursor-pointer transition-colors"
          style="border: 1px solid var(--c-terracotta); color: var(--c-terracotta);"
          onmouseenter="this.style.background='var(--c-terracotta)'; this.style.color='var(--c-base)'"
          onmouseleave="this.style.background='transparent'; this.style.color='var(--c-terracotta)'"
        >
          Enter
        </button>
      </div>
      <p id="rsvp-error" class="type-label mt-3 hidden" style="color: var(--c-terracotta);">
        That's not quite right.
      </p>
    </div>

    <form id="rsvp-form" class="hidden space-y-8">
      <label class="block">
        <span class="type-label block mb-2" style="color: color-mix(in srgb, var(--c-ink) 60%, transparent);">Your name</span>
        <input
          name="name"
          required
          class="w-full bg-transparent px-0 py-2"
          style="border-bottom: 1px solid color-mix(in srgb, var(--c-ink) 30%, transparent); font-family: var(--font-family-body); color: var(--c-ink);"
          onfocus="this.style.borderBottomColor='var(--c-terracotta)'"
          onblur="this.style.borderBottomColor='color-mix(in srgb, var(--c-ink) 30%, transparent)'"
        />
      </label>

      <fieldset class="border-0 p-0 m-0">
        <legend class="type-label mb-3" style="color: color-mix(in srgb, var(--c-ink) 60%, transparent);">
          Will you be there?
        </legend>
        <div class="flex gap-6">
          {['Yes', 'No', 'Maybe'].map((val) => (
            <label class="flex items-center gap-2 cursor-pointer">
              <input
                type="radio"
                name="attending"
                value={val}
                required
                style="accent-color: var(--c-terracotta);"
              />
              <span style="font-family: var(--font-family-body);">{val}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <label class="block">
        <span class="type-label block mb-2" style="color: color-mix(in srgb, var(--c-ink) 60%, transparent);">
          Dietary restrictions
        </span>
        <input
          name="dietary"
          placeholder="None, vegetarian, gluten-free..."
          class="w-full bg-transparent px-0 py-2"
          style="border-bottom: 1px solid color-mix(in srgb, var(--c-ink) 30%, transparent); font-family: var(--font-family-body); color: var(--c-ink);"
          onfocus="this.style.borderBottomColor='var(--c-terracotta)'"
          onblur="this.style.borderBottomColor='color-mix(in srgb, var(--c-ink) 30%, transparent)'"
        />
      </label>

      <fieldset class="border-0 p-0 m-0">
        <legend class="type-label mb-3" style="color: color-mix(in srgb, var(--c-ink) 60%, transparent);">
          Bringing a plus one?
        </legend>
        <div class="flex gap-6 mb-4">
          {['Yes', 'No'].map((val) => (
            <label class="flex items-center gap-2 cursor-pointer">
              <input
                type="radio"
                name="plusOne"
                value={val}
                style="accent-color: var(--c-terracotta);"
                onchange={`document.getElementById('plus-one-name-wrap').style.display = '${val === 'Yes' ? 'block' : 'none'}'`}
              />
              <span style="font-family: var(--font-family-body);">{val}</span>
            </label>
          ))}
        </div>
        <div id="plus-one-name-wrap" style="display: none;">
          <label class="block">
            <span class="type-label block mb-2" style="color: color-mix(in srgb, var(--c-ink) 60%, transparent);">
              Plus one's name
            </span>
            <input
              name="plusOneName"
              class="w-full bg-transparent px-0 py-2"
              style="border-bottom: 1px solid color-mix(in srgb, var(--c-ink) 30%, transparent); font-family: var(--font-family-body); color: var(--c-ink);"
              onfocus="this.style.borderBottomColor='var(--c-terracotta)'"
              onblur="this.style.borderBottomColor='color-mix(in srgb, var(--c-ink) 30%, transparent)'"
            />
          </label>
        </div>
      </fieldset>

      <label class="block">
        <span class="type-label block mb-2" style="color: color-mix(in srgb, var(--c-ink) 60%, transparent);">
          Song request
        </span>
        <input
          name="songRequest"
          placeholder="We'll do our best"
          class="w-full bg-transparent px-0 py-2"
          style="border-bottom: 1px solid color-mix(in srgb, var(--c-ink) 30%, transparent); font-family: var(--font-family-body); color: var(--c-ink);"
          onfocus="this.style.borderBottomColor='var(--c-terracotta)'"
          onblur="this.style.borderBottomColor='color-mix(in srgb, var(--c-ink) 30%, transparent)'"
        />
      </label>

      <label class="block">
        <span class="type-label block mb-2" style="color: color-mix(in srgb, var(--c-ink) 60%, transparent);">
          Anything else?
        </span>
        <textarea
          name="message"
          rows={3}
          class="w-full bg-transparent px-0 py-2 resize-none"
          style="border-bottom: 1px solid color-mix(in srgb, var(--c-ink) 30%, transparent); font-family: var(--font-family-body); color: var(--c-ink);"
          onfocus="this.style.borderBottomColor='var(--c-terracotta)'"
          onblur="this.style.borderBottomColor='color-mix(in srgb, var(--c-ink) 30%, transparent)'"
        />
      </label>

      <button
        type="submit"
        class="type-label px-8 py-3 cursor-pointer transition-colors"
        style="border: 1px solid var(--c-terracotta); color: var(--c-terracotta);"
        onmouseenter="this.style.background='var(--c-terracotta)'; this.style.color='var(--c-base)'"
        onmouseleave="this.style.background='transparent'; this.style.color='var(--c-terracotta)'"
      >
        Send RSVP
      </button>

      <p id="rsvp-submitting" class="type-label hidden" style="color: color-mix(in srgb, var(--c-ink) 50%, transparent);">
        Sending…
      </p>
      <p id="rsvp-submit-error" class="type-label hidden" style="color: var(--c-terracotta);">
        Something went wrong. Please try again or email us directly.
      </p>
    </form>

    <div id="rsvp-confirm" class="hidden text-center py-12 space-y-4">
      <img
        src="/images/colophon.svg"
        alt=""
        class="w-16 mx-auto dark:invert"
        style="opacity: 0.6;"
        width="64"
        height="64"
      />
      <p style="font-family: var(--font-family-body); font-size: var(--text-xl);">
        We'll see you there.
      </p>
    </div>
  </section>

  <!-- ─── Registry ─────────────────────────────────────────────────────────── -->
  <section class="px-6 py-16 max-w-2xl mx-auto text-center">
    <h2 class="type-label mb-6" style="color: var(--c-terracotta);" data-reveal>Registry</h2>
    <p class="mb-4" style="color: color-mix(in srgb, var(--c-ink) 70%, transparent);" data-reveal>
      Your presence is the gift. If you'd like to give something, we'll have a registry soon —
      check back closer to the date.
    </p>
    <p class="type-label" style="color: color-mix(in srgb, var(--c-ink) 30%, transparent);" data-reveal>
      <!-- {{registry-url}} — link goes here when platform is decided -->
      More details coming soon.
    </p>
  </section>

  <!-- ─── Secondary page links ─────────────────────────────────────────────── -->
  <section class="px-6 py-16 max-w-2xl mx-auto">
    <div class="diamond-rule mb-12" data-reveal>
      <span aria-hidden="true">◆</span>
    </div>
    <h2 class="type-label mb-8" style="color: color-mix(in srgb, var(--c-ink) 40%, transparent);" data-reveal>
      Everything else
    </h2>
    <nav aria-label="More info" class="space-y-4">
      {[
        ['/venue',  'The Venue',      'About the New Mexico Museum of Art, directions, and what to expect.'],
        ['/stay',   'Where to Stay',  'Our picks for hotels and neighborhoods in Santa Fe.'],
        ['/do',     'Things to Do',   'A guide to spending time in one of our favorite cities.'],
        ['/faq',    'FAQ',            'Attire, weather, food, and other things you might be wondering.'],
      ].map(([href, label, desc]) => (
        <a
          href={href}
          class="flex justify-between items-baseline py-4 group transition-colors"
          style="border-bottom: 1px solid color-mix(in srgb, var(--c-ink) 10%, transparent);"
          data-reveal
          onmouseenter="this.style.borderBottomColor='color-mix(in srgb, var(--c-terracotta) 40%, transparent)'"
          onmouseleave="this.style.borderBottomColor='color-mix(in srgb, var(--c-ink) 10%, transparent)'"
        >
          <span style="font-family: var(--font-family-display); font-size: var(--text-xl); font-weight: 700; color: var(--c-ink);">
            {label}
          </span>
          <span class="type-label hidden md:block" style="color: color-mix(in srgb, var(--c-ink) 40%, transparent); max-width: 30ch; text-align: right;">
            {desc}
          </span>
        </a>
      ))}
    </nav>
  </section>

  <!-- ─── Easter egg: Konami overlay ───────────────────────────────────────── -->
  <div
    id="konami-overlay"
    class="hidden fixed inset-0 flex items-center justify-center z-50 cursor-pointer"
    style="background: color-mix(in srgb, var(--c-base) 95%, transparent);"
    aria-live="polite"
  >
    <div class="text-center space-y-4 max-w-sm px-6">
      <img src="/images/colophon.svg" alt="" class="w-20 mx-auto dark:invert" width="80" height="80" />
      <p class="type-display" style="font-size: var(--text-2xl);">There you are.</p>
      <p style="color: color-mix(in srgb, var(--c-ink) 60%, transparent);">
        Good instincts. We like you already.
        See you July 11.
      </p>
      <p class="type-label" style="color: color-mix(in srgb, var(--c-ink) 30%, transparent);">
        Click anywhere to close.
      </p>
    </div>
  </div>

  <Footer />
</Base>

<script>
  let rsvpPassword = ''

  window.checkRSVPPassword = function () {
    const input = document.getElementById('rsvp-password') as HTMLInputElement
    const error = document.getElementById('rsvp-error')

    fetch('/api/rsvp-check', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ password: input.value }),
    })
      .then((r) => r.json())
      .then((data: { valid: boolean }) => {
        if (data.valid) {
          rsvpPassword = input.value
          document.getElementById('rsvp-gate')?.classList.add('hidden')
          document.getElementById('rsvp-form')?.classList.remove('hidden')
          error?.classList.add('hidden')
        } else {
          error?.classList.remove('hidden')
          input.focus()
        }
      })
      .catch(() => {
        error?.classList.remove('hidden')
      })
  }

  window.submitRSVP = async function (e: Event) {
    e.preventDefault()
    const form = e.target as HTMLFormElement
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement
    const submitting = document.getElementById('rsvp-submitting')
    const submitError = document.getElementById('rsvp-submit-error')

    submitBtn.disabled = true
    submitting?.classList.remove('hidden')
    submitError?.classList.add('hidden')

    const formData = new FormData(form)
    const data: Record<string, string> = {}
    formData.forEach((val, key) => { data[key] = String(val) })
    data['password'] = rsvpPassword

    try {
      const res = await fetch('/api/rsvp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      })

      if (res.ok) {
        document.getElementById('rsvp-form')?.classList.add('hidden')
        document.getElementById('rsvp-confirm')?.classList.remove('hidden')
      } else {
        submitBtn.disabled = false
        submitting?.classList.add('hidden')
        submitError?.classList.remove('hidden')
      }
    } catch {
      submitBtn.disabled = false
      submitting?.classList.add('hidden')
      submitError?.classList.remove('hidden')
    }
  }

  document.getElementById('rsvp-password')?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') window.checkRSVPPassword()
  })

  document.getElementById('rsvp-form')?.addEventListener('submit', (e) => {
    window.submitRSVP(e)
  })
</script>

<script src="../scripts/easter-eggs.js"></script>
