---
// Guest photo collection — the one URL guests ever see: owenrowan.love/photos
// Phase 0: site chrome around the Wedibox uploader (iframe embed).
// Phase 2: the embed gets swapped for the Permanent Collection acquisitions page.
import Base from '../layouts/Base.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
import Footer from '../components/Footer.astro'

// Note: the iframe snippet in the Wedibox dashboard points at embed.wedibox.com,
// which 403s — their own widget.js actually loads www.wedibox.com/w/e/<event-id>.
const WEDIBOX_EMBED = 'https://www.wedibox.com/w/e/fec3f200-2376-41fc-b0d2-3265d144159d'
const WEDIBOX_PAGE = 'https://www.wedibox.com/w/photo-collection/recRM0jgRdqZkaTN'
---
<Base title="Photos — Owen & Rowan" description="Send us your photos and videos — no app, no account.">
  <Breadcrumb />

  <article class="px-6 max-w-3xl mx-auto pb-24 relative overflow-hidden">

    <img
      src="/illustrations/pinon-bg.svg"
      alt=""
      aria-hidden="true"
      class="absolute -right-12 top-0 w-1/2 max-w-xs pointer-events-none select-none"
      style="opacity: 0.07; color: var(--c-ink);"
      width="400"
      height="600"
    />

    <p class="type-label mb-6 relative" style="color: color-mix(in srgb, var(--c-ink) 50%, transparent);" data-reveal>
      July 11, 2026 — Santa Fe
    </p>

    <h1 class="type-display mb-8 relative" style="font-size: clamp(2.5rem, 6vw, 4.5rem);" data-reveal>
      Photo Portal
    </h1>

    <div class="prose-wedding mb-12 relative" data-reveal>
      <p>
        Please share your photos here &lt;3
      </p>
    </div>

    <!-- z-index above the body::after grain overlay (9999) so the uploader renders crisp -->
    <section class="mb-8 relative" style="z-index: 10000;" data-reveal>
      <iframe
        src={WEDIBOX_EMBED}
        title="Upload your photos"
        allow="camera; microphone"
        loading="eager"
        style="width: 100%; height: min(80vh, 900px); min-height: 560px; border: 1px solid color-mix(in srgb, var(--c-ink) 15%, transparent); background: #F2EBD9;"
      ></iframe>
      <p class="type-label mt-4 text-center">
        <a href={WEDIBOX_PAGE} class="link-draw" target="_blank" rel="noopener noreferrer">
          Trouble loading? Open the uploader directly ↗
        </a>
      </p>
    </section>

    <p class="prose-wedding relative" style="color: color-mix(in srgb, var(--c-ink) 60%, transparent);" data-reveal>
      We'll share the full album with everyone after the wedding.
    </p>

  </article>

  <Footer />
</Base>
