---
import Base from '../layouts/Base.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
import Card from '../components/Card.astro'
import Modal from '../components/Modal.astro'
import Footer from '../components/Footer.astro'
import { hotels } from '../content/hotels'
import { neighborhoods } from '../content/neighborhoods'
---
<Base title="Where to Stay — Owen & Rowan" description="Our picks for hotels and Airbnb neighborhoods in Santa Fe.">
  <Breadcrumb />

  <article class="px-6 max-w-5xl mx-auto pb-24">

    <h1 class="type-display mb-4" style="font-size: clamp(2.5rem, 6vw, 4.5rem);" data-reveal>
      Where to Stay
    </h1>
    <p class="mb-16 max-w-2xl" style="color: color-mix(in srgb, var(--c-ink) 70%, transparent);" data-reveal>
      We're not running a room block but have recommendations on where to stay.
      Most of these hotels are near the plaza and just a short walk from the venue!
      We do recommend booking early since July is peak season in Santa Fe and
      rooms fill up.
    </p>

    <!-- Hotel cards -->
    <section class="mb-24">
      <h2 class="type-label mb-12" style="color: var(--c-terracotta);" data-reveal>Hotels</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 items-start">
        {hotels.map((hotel) => (
          <>
            <Card
              id={hotel.id}
              name={hotel.name}
              tagline={hotel.tagline}
              illustration={hotel.illustration}
              photo={hotel.photo}
            />
            <Modal
              id={hotel.id}
              name={hotel.name}
              tagline={hotel.tagline}
              description={hotel.description}
              illustration={hotel.illustration}
              photo={hotel.photo}
              practical={hotel.practical}
              url={hotel.url}
            />
          </>
        ))}
      </div>
    </section>

    <!-- Airbnb neighborhoods -->
    <section class="mb-24">
      <h2 class="type-label mb-12" style="color: var(--c-terracotta);" data-reveal>Airbnb Neighborhoods</h2>
      <div class="grid sm:grid-cols-2 gap-8 items-start">
        {neighborhoods.map((n) => (
          <>
            <Card
              id={`neighborhood-${n.id}`}
              name={n.name}
              tagline={n.tagline}
              illustration={n.photo}
              photo={n.photo}
            />
            <Modal
              id={`neighborhood-${n.id}`}
              name={n.name}
              tagline={n.tagline}
              description={n.description}
              illustration={n.photo}
              photo={n.photo}
              url={n.url}
              linkLabel="Search on Airbnb ↗"
            />
          </>
        ))}
      </div>
    </section>

  </article>

  <Footer />
</Base>
